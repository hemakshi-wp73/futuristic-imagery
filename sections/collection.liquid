{% comment %}
  Fully Customizable Collection Grid Section
  Includes: Responsive grid, hover effects, aspect ratios, pagination toggles, and performance optimization.
{% endcomment %}

<style>
  .collection-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --grid-gap: {{ section.settings.grid_gap }}px;
    --cols-desktop: {{ section.settings.columns_desktop }};
    --cols-mobile: {{ section.settings.columns_mobile }};
    --cols-tablet: {% if section.settings.columns_desktop >= 3 %}3{% else %}2{% endif %};
    --card-align: {{ section.settings.card_alignment }};
    --container-max-width: {{ section.settings.container_max_width }}px;
  }

  @media screen and (max-width: 749px) {
    .collection-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
  }

  .collection-container {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    margin-left: auto;
    margin-right: auto;
  }

  .collection-container--fit-content {
    max-width: var(--container-max-width);
  }

  .collection-container--full-width {
    max-width: 100%;
  }

  .collection-grid-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: var(--grid-gap);
    justify-content: center; /* Center-align products if row is not full */
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .product-card-wrapper {
    display: flex;
    flex-direction: column;
    position: relative;
    /* Calculate dynamic width using Flexbox and explicit column counts */
    width: calc((100% - (var(--cols-desktop) - 1) * var(--grid-gap)) / var(--cols-desktop));
  }

  @media screen and (max-width: 989px) {
    .product-card-wrapper {
      width: calc((100% - (var(--cols-tablet) - 1) * var(--grid-gap)) / var(--cols-tablet));
    }
  }

  @media screen and (max-width: 749px) {
    .product-card-wrapper {
      width: calc((100% - (var(--cols-mobile) - 1) * var(--grid-gap)) / var(--cols-mobile));
    }
  }

  .product-card__image-wrapper {
    position: relative;
    width: 100%;
    background-color: #f4f4f4;
    border-radius: 4px;
    overflow: hidden;
  }

  /* Aspect Ratio controls */
  .product-card__image-wrapper--square { aspect-ratio: 1 / 1; }
  .product-card__image-wrapper--portrait { aspect-ratio: 4 / 5; }
  .product-card__image-wrapper--landscape { aspect-ratio: 3 / 2; }

  .product-card__image-wrapper img,
  .product-card__image-wrapper svg.placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, transform 0.4s ease;
  }

  .product-card__image-wrapper--original img,
  .product-card__image-wrapper--original svg.placeholder-svg {
    position: relative;
    aspect-ratio: auto; /* Fallback for original */
    height: auto;
  }
  .product-card__image-wrapper--original svg.placeholder-svg {
    aspect-ratio: 1 / 1;
  }

  .product-card__image-secondary {
    opacity: 0;
    z-index: 1;
  }

  {% if section.settings.enable_hover_effect %}
  .product-card-wrapper:hover .product-card__image-primary.has-secondary {
    opacity: 0;
  }
  .product-card-wrapper:hover .product-card__image-secondary {
    opacity: 1;
    transform: scale(1.03); /* subtle zoom effect */
  }
  .product-card-wrapper:hover .product-card__image-primary:not(.has-secondary) {
    transform: scale(1.03);
  }
  {% endif %}

  .product-card__info {
    padding-top: 1.2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: var(--card-align);
  }

  .product-card__vendor {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #666;
    margin-bottom: 0.4rem;
  }

  .product-card__title {
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .product-card__title-link {
    color: inherit;
    text-decoration: none;
  }

  /* Expand clickable area to entire card */
  .product-card__title-link::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .product-card__prices {
    margin-bottom: 1rem;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    justify-content: {% if section.settings.card_alignment == 'center' %}center{% elsif section.settings.card_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    flex-wrap: wrap;
  }

  .product-card__price {
    font-weight: 600;
    color: #111;
  }

  .product-card__price--sale {
    color: #d90000;
  }

  .product-card__compare-price {
    text-decoration: line-through;
    color: #888;
    font-size: 0.9rem;
  }

  .product-card__form {
    margin-top: auto;
    position: relative;
    z-index: 2; /* Sits above the stretched link to be interactable */
  }

  .product-card__add-to-cart {
    width: 100%;
    padding: 0.75rem 1rem;
    background-color: #111;
    color: #fff;
    border: 1px solid #111;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
    text-align: center;
    transition: all 0.2s ease;
    font-size: 0.9rem;
  }
  
  .product-card__add-to-cart:hover:not([disabled]) {
    background-color: #fff;
    color: #111;
  }
  
  .product-card__add-to-cart[disabled] {
    background-color: #f4f4f4;
    color: #aaa;
    border-color: #e5e5e5;
    cursor: not-allowed;
  }

  /* Pagination */
  .collection-pagination {
    margin-top: 4rem;
    text-align: center;
  }
  
  .collection-pagination .pagination {
    display: inline-flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
  }

  .collection-pagination .page a,
  .collection-pagination .page span,
  .collection-pagination .prev a,
  .collection-pagination .next a {
    padding: 0.5rem 1rem;
    border: 1px solid #e5e5e5;
    text-decoration: none;
    color: #333;
    border-radius: 4px;
    transition: border-color 0.2s ease;
  }

  .collection-pagination .page a:hover,
  .collection-pagination .prev a:hover,
  .collection-pagination .next a:hover {
    border-color: #111;
  }

  .collection-pagination .page.current span {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .load-more-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: #111;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 500;
    transition: opacity 0.2s;
  }
  .load-more-btn:hover {
    opacity: 0.8;
  }
</style>

<div class="collection-section-{{ section.id }}">
  <div class="collection-container {% if section.settings.container_width == 'fit-content' %}collection-container--fit-content{% else %}collection-container--full-width{% endif %}">
    
    {% paginate collection.products by section.settings.products_per_page %}
      <div class="collection-grid-{{ section.id }}">
        {% for product in collection.products %}
          <div class="product-card-wrapper">
            
            <div class="product-card__image-wrapper product-card__image-wrapper--{{ section.settings.image_ratio }}">
              {% if product.featured_media %}
                <img src="{{ product.featured_media | image_url: width: 720 }}"
                     alt="{{ product.featured_media.alt | escape }}"
                     loading="lazy"
                     width="{{ product.featured_media.width }}"
                     height="{{ product.featured_media.height }}"
                     class="product-card__image-primary {% if product.media[1] != blank and section.settings.enable_hover_effect %}has-secondary{% endif %}">
                
                {% if product.media[1] != blank and section.settings.enable_hover_effect %}
                  <img src="{{ product.media[1] | image_url: width: 720 }}"
                       alt="{{ product.media[1].alt | escape }}"
                       loading="lazy"
                       width="{{ product.media[1].width }}"
                       height="{{ product.media[1].height }}"
                       class="product-card__image-secondary">
                {% endif %}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            
            <div class="product-card__info">
              {% if section.settings.show_vendor %}
                <div class="product-card__vendor">{{ product.vendor }}</div>
              {% endif %}
              
              {% if section.settings.show_title %}
                <h3 class="product-card__title">
                  <a href="{{ product.url | within: collection }}" class="product-card__title-link">
                    {{ product.title }}
                  </a>
                </h3>
              {% endif %}
              
              <div class="product-card__prices">
                {% if section.settings.show_price %}
                  {% if product.compare_at_price > product.price and section.settings.show_compare_price %}
                    <span class="product-card__compare-price">{{ product.compare_at_price | money }}</span>
                    <span class="product-card__price product-card__price--sale">{{ product.price | money }}</span>
                  {% else %}
                    <span class="product-card__price">{{ product.price | money }}</span>
                  {% endif %}
                {% endif %}
              </div>
            </div>
            
            {% if section.settings.show_add_to_cart %}
              <form method="post" action="/cart/add" class="product-card__form">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="product-card__add-to-cart" {% unless product.available %}disabled{% endunless %}>
                  {% if product.available %}
                    Add to cart
                  {% else %}
                    Sold out
                  {% endif %}
                </button>
              </form>
            {% endif %}

          </div>
        {% endfor %}
      </div>
      
      {% if paginate.pages > 1 %}
        <div class="collection-pagination" data-pagination-type="{{ section.settings.pagination_type }}">
          {% if section.settings.pagination_type == 'paginate' %}
            {{ paginate | default_pagination }}
          {% else %}
             {% if paginate.next %}
               <a href="{{ paginate.next.url }}" class="load-more-btn">Load More Products</a>
             {% endif %}
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</div>

{% if section.settings.pagination_type == 'infinite' %}
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const sectionId = "{{ section.id }}";
    const wrapper = document.querySelector(`.collection-grid-${sectionId}`);
    const paginationContainer = document.querySelector(`.collection-section-${sectionId} .collection-pagination`);
    
    if (wrapper && paginationContainer) {
      paginationContainer.addEventListener('click', function(e) {
        if (e.target.classList.contains('load-more-btn')) {
          e.preventDefault();
          const btn = e.target;
          const url = btn.getAttribute('href');
          btn.innerHTML = 'Loading...';
          btn.style.opacity = '0.7';
          btn.style.pointerEvents = 'none';
          
          fetch(url)
            .then(response => response.text())
            .then(html => {
              const parser = new DOMParser();
              const doc = parser.parseFromString(html, 'text/html');
              
              // Append new items
              const newProducts = doc.querySelectorAll(`.collection-grid-${sectionId} .product-card-wrapper`);
              newProducts.forEach(product => wrapper.appendChild(product));
              
              // Update pagination button or remove if no more pages
              const newPagination = doc.querySelector(`.collection-section-${sectionId} .collection-pagination`);
              const newBtn = newPagination ? newPagination.querySelector('.load-more-btn') : null;
              
              if (newBtn) {
                btn.setAttribute('href', newBtn.getAttribute('href'));
                btn.innerHTML = 'Load More Products';
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
              } else {
                paginationContainer.remove();
              }
            })
            .catch(err => {
              console.error('Failed to load products', err);
              btn.innerHTML = 'Try again';
              btn.style.opacity = '1';
              btn.style.pointerEvents = 'auto';
            });
        }
      });
    }
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
        { "value": "fit-content", "label": "Fit Content" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width (Fit Content)",
      "default": 1200
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Grid Gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Pagination style",
      "options": [
        { "value": "paginate", "label": "Pagination (Numbers)" },
        { "value": "infinite", "label": "Load More (Infinite Scroll JS)" }
      ],
      "default": "paginate"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 16
    },
    {
      "type": "header",
      "content": "Product Card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "original", "label": "Original (Auto height)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (3:2)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_effect",
      "label": "Enable image hover effect",
      "info": "Shows the second image on hover or zooms if not available.",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Content Configuration"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show 'Add to cart' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
