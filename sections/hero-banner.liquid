
<div class=" {% if section.settings.content_width == 'page_width' %} page-width {% endif %}">
<section
  class="hero hero--{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="hero__media">
    {% if section.settings.desktop_image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 767px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
          >
        {% endif %}
        <img
          src="{{ section.settings.desktop_image | image_url: width: 2000 }}"
          alt="{{ section.settings.desktop_image.alt | escape }}"
          width="{{ section.settings.desktop_image.width }}"
          height="{{ section.settings.desktop_image.height }}"
          loading="eager"
          fetchpriority="high"
          class="hero__image"
        >
      </picture>
      {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
  <div class="hero__content page-width">
 {% content_for 'blocks' %}
</div>
</section>
</div>
{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
     {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "full_width",
      "options": [
        { "value": "full_width", "label": "Full Width" },
        { "value": "page_width", "label": "Page width" },
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 8,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
       "blocks": [
        { "type": "hero-text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
 