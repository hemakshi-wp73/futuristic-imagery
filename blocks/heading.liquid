<div
  class="heading__text heading__text--{{ block.settings.text_type }}"
  style="
  margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    text-align: {{ block.settings.text_align }};
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.text != blank %}
    <{{ block.settings.text_tag }} class="heading">
      {{ block.settings.text }}
    </{{ block.settings.text_tag }}>
  {% endif %} 
</div>
{% style %}
.heading p
{
  font-size: {{ block.settings.font_size }};
  color:  rgb(var(--color-foreground));
}
{% endstyle %}
{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text content",
      "default": "<h2> A Theme Built to Define Your Brand </h2>"
    },
    {
      "type": "select",
      "id": "text_tag",
      "label": "Text size",
      "default": "p",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" },
        { "value": "p", "label": "Paragraph" },
        { "value": "div", "label": "custom" },
      ]
    },
      {
      "type": "select",
      "id": "font_size",
      "label": "Size",
      "options": [

        {
          "value": "10px",
          "label": "10px"
        },
        {
          "value": "12px",
          "label": "12px"
        },
        {
          "value": "14px",
          "label": "14px"
        },
        {
          "value": "16px",
          "label": "16px"
        },
        {
          "value": "18px",
          "label": "18px"
        },
        {
          "value": "20px",
          "label": "20px"
        },
        {
          "value": "24px",
          "label": "24px"
        },
        {
          "value": "32px",
          "label": "32px"
        },
        {
          "value": "40px",
          "label": "40px"
        },
        {
          "value": "48px",
          "label": "48px"
        },
        {
          "value": "56px",
          "label": "56px"
        },
        {
          "value": "72px",
          "label": "72px"
        },
        {
          "value": "88px",
          "label": "88px"
        },
        {
          "value": "120px",
          "label": "120px"
        },
        {
          "value": "152px",
          "label": "152px"
        },
        {
          "value": "184px",
          "label": "184px"
        }
      ],
      "default": "32px",
      "visible_if": "{{ block.settings.text_tag == 'div' }}"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16
    }
  ],
  "presets":[
    {
      "name": "Heading"
    }
  ]
}
{% endschema %}
 