{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.page_content_width }}px;
    --page-gap: {{ settings.page_side_gap }}px;

    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    --primary-button-radius: {{ settings.primary_button_radius }}%;
    --primary-button-border-width: {{ settings.primary_border_width }}px;

    --secondary-button-radius: {{ settings.secondary_button_radius }}%;
    --secondary-button-border-width: {{ settings.secondary_border_width }}px;
  }

  {% for scheme in settings.color_schemes %}
    
    .scheme-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background.rgb }};
      --color-foreground: {{ scheme.settings.foreground.rgb }};

      --color-primary-button: {{ scheme.settings.primary_button_background.rgb }};
      --color-secondary-button: {{ scheme.settings.secondary_button_background.rgb }};

      --color-primary-button-hover: {{ scheme.settings.primary_button_hover_background.rgb }};
      --color-secondary-button-hover: {{ scheme.settings.secondary_button_hover_background.rgb }};

      --color-on-primary-button: {{ scheme.settings.primary_button_text.rgb }};
      --color-on-secondary-button: {{ scheme.settings.secondary_button_text.rgb }};

      --color-on-primary-button-hover: {{ scheme.settings.primary_button_hover_text.rgb }};
      --color-on-secondary-button-hover: {{ scheme.settings.secondary_button_hover_text.rgb }};

      --color-primary-button-border: {{ scheme.settings.primary_button_border.rgb }};
      --color-secondary-button-border: {{ scheme.settings.secondary_button_border.rgb }};

      --color-primary-button-border-hover: {{ scheme.settings.primary_button_hover_border.rgb }};
      --color-secondary-button-border-hover: {{ scheme.settings.secondary_button_hover_border.rgb }};

      --color-outline_button_text: {{ scheme.settings.outline_button_text.rgb }};
      --color-outline_button_border: {{ scheme.settings.outline_button_border.rgb }};

      --color-outline_button_text-hover: {{ scheme.settings.outline_button_hover_text.rgb }};
      --color-outline_button_border-hover: {{ scheme.settings.outline_button_hover_border.rgb }};
    }
    {% endfor %}
{% endstyle %}
